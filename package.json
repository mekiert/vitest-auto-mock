{
  "name": "vitest-auto-mock",
  "version": "0.1.3",
  "description": "Library for mocking dependencies in Vitest with TypeScript without need to provide a path.",
  "keywords": [
    "Vitest",
    "testing",
    "mocking",
    "mock",
    "mocks",
    "automock",
    "TypeScript",
    "ts"
  ],
  "author": {
    "name": "Mateusz Ekiert",
    "email": "mekiert.software@proton.me"
  },
  "homepage": "https://github.com/mekiert/vitest-auto-mock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mekiert/vitest-auto-mock.git"
  },
  "license": "MIT",
  "type": "module",
  "lockFileVersion": 3,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsc && vitest",
    "build": "tsc && vite build",
    "build-lib": "tsc && vite build && npm pack --pack-destination=./build-lib"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.11",
    "@vitejs/plugin-react": "5.1.3",
    "jsdom": "28.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "vitest": "*"
  },
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    }
  }
}
